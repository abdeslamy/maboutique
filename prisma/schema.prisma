// ==========================================================================
// Schéma Prisma — Ma Boutique
// ==========================================================================
// Ce fichier décrit toutes les tables de la base.
// Chaque fois qu'on modifie ce fichier, on crée une nouvelle migration :
//    npx prisma migrate dev --name description-du-changement
// ==========================================================================

// ── Générateur : où et comment est produit le client TypeScript ─────────
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// ── Datasource : quel type de base et où elle est ─────────────────────
datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════════════════
// Boutique — le TENANT
// ══════════════════════════════════════════════════════════════════════
// Chaque marchand possède une boutique. Toutes les autres tables métier
// portent un `boutiqueId` : c'est l'étiquette qui dit « ceci appartient à
// tel marchand ».
//
// Règle absolue : AUCUNE requête ne doit franchir cette frontière, sauf
// depuis les fonctions nommées de la marketplace, en lecture seule.
//
//  - slug : identifiant lisible, sert au format sous-chemin
//    (maplateforme.dz/coursa) et au sous-domaine (coursa.maplateforme.dz).
//  - visibleMarketplace : le marchand peut refuser d'apparaître sur la
//    vitrine agrégée. Le champ existe AVANT la marketplace : l'ajouter
//    aujourd'hui coûte une ligne, l'ajouter après coup coûte une migration
//    sur des données de production.
//  - statut : "active" | "suspendue". Une boutique suspendue (impayé,
//    abus) cesse de servir ses pages sans que ses données soient touchées.
model Boutique {
  id                 String   @id
  nom                String
  slug               String   @unique
  statut             String   @default("active")
  visibleMarketplace Boolean  @default(true)
  createdAt          DateTime @default(now())

  produits    Produit[]
  commandes   Commande[]
  categories  Categorie[]
  tarifs      TarifLivraison[]
  membres     Utilisateur[]
  parametres  ParametresBoutique?
}

// ══════════════════════════════════════════════════════════════════════
// Utilisateur
// ══════════════════════════════════════════════════════════════════════
// Notes :
//  - id : identifiant opaque, généré automatiquement par Prisma (cuid).
//  - motDePasse : c'est le HASH bcrypt, pas le mot de passe en clair.
//  - image : photo de profil (base64 pour l'instant, URL plus tard).
//  - role : "user" par défaut ; "admin" pour toi et les admins futurs.
//  - commandes : relation "1 utilisateur → N commandes".
//
// ⚠️ L'unicité de l'email est PAR BOUTIQUE, plus globale : chaque marchand
//    est responsable de ses propres clients, et la même personne peut être
//    cliente chez deux marchands sans que l'un sache rien de l'autre.
//    Le jour où la marketplace aura besoin d'un compte transverse, ce sera
//    une table de plus — pas une réécriture de celle-ci.
model Utilisateur {
  id         String     @id @default(cuid())
  nom        String
  email      String
  motDePasse String
  image      String?
  role       String     @default("user")
  createdAt  DateTime   @default(now())

  boutiqueId String
  boutique   Boutique   @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  commandes  Commande[]

  @@unique([boutiqueId, email])
}

// ══════════════════════════════════════════════════════════════════════
// Produit
// ══════════════════════════════════════════════════════════════════════
// Notes :
//  - id : on garde la CONVENTION ACTUELLE (slug lisible comme "tshirt-coton-blanc")
//    pour que les URLs /produits/[id] et le panier localStorage continuent
//    de fonctionner. Prisma ne génère PAS ce champ automatiquement (pas de
//    @default) — on le fournit à la création (seed ou admin).
//  - Les textes sont dans les 2 langues (nomFr, nomAr, descFr, descAr).
//  - prix : entier, en DA (dinar algérien, monnaie entière).
//  - categorie : String pour rester simple. On pourrait passer en enum plus tard.
//  - images : String[] = TABLEAU de chaînes. PostgreSQL supporte les arrays
//    nativement. Pour l'instant on y met des classes Tailwind (placeholder).
//    Plus tard, on mettra des URLs vers Cloudinary/UploadThing.
//  - videoUrl : URL de la vidéo produit, optionnelle. Le champ EXISTE dès
//    maintenant pour éviter une 2e migration quand on ajoutera l'upload vidéo.
//  - emoji : petit décorateur pour les placeholders actuels.
model Produit {
  id             String          @id
  nomFr          String
  nomAr          String
  descriptionFr  String
  descriptionAr  String
  prix           Int
  categorie      String
  images         String[]
  videoUrl       String?
  // emoji : plus saisi dans le formulaire (les produits ont de vraies photos).
  // La colonne reste pour les produits historiques qui s'en servent encore
  // comme vignette de repli. Valeur par défaut pour les nouveaux produits.
  emoji          String          @default("📦")
  // Stock total disponible. 0 = rupture → le produit n'est plus commandable.
  // Décrémenté automatiquement à chaque commande (voir creerCommande).
  stock          Int             @default(0)
  // Délai annoncé au client, PAR PRODUIT (il varie selon l'article).
  // Valeurs : "48h" | "3_5j" | "1semaine" | "plus_1semaine".
  delaiLivraison String          @default("3_5j")
  // Livraison offerte sur CE produit, quel que soit le tarif de la wilaya.
  livraisonGratuite Boolean      @default(false)
  createdAt      DateTime        @default(now())

  boutiqueId     String
  boutique       Boutique        @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  lignesCommande LigneCommande[]

  // ⚠️ DETTE CONNUE. `id` reste ici un slug lisible ET la clé primaire, donc
  // GLOBALE. Deux marchands qui vendent un « casque-bluetooth » entreront en
  // collision. Ça ne pose aucun problème tant qu'il n'y a qu'une boutique ;
  // ça doit être corrigé AVANT d'accueillir le deuxième marchand (clé
  // technique + slug unique par boutique). Traité dans un lot séparé.
  @@index([boutiqueId])
}

// ══════════════════════════════════════════════════════════════════════
// Commande
// ══════════════════════════════════════════════════════════════════════
// Notes :
//  - utilisateurId : optionnel (?) → une commande peut exister SANS compte
//    utilisateur (achat en tant qu'invité). Si l'utilisateur est connecté,
//    la commande est rattachée à son id.
//  - statut : cycle de vie d'une commande. Le champ EXISTE dès maintenant
//    pour préparer ton admin. Valeurs prévues :
//      "en_attente"     → juste créée
//      "confirmee"      → tu as validé la commande
//      "en_livraison"   → colis en route
//      "livree"         → livrée au client
//      "annulee"        → annulée
//  - onDelete: SetNull : si un utilisateur est supprimé, ses commandes
//    ne sont PAS supprimées (comptabilité !). Juste dé-rattachées.
model Commande {
  id            String          @id @default(cuid())
  nomClient     String
  telephone     String
  adresse       String
  wilaya        String
  sousTotal     Int
  livraison     Int
  total         Int
  // "domicile" ou "stopdesk" — figé au moment de la commande, car le tarif
  // de la wilaya peut changer plus tard sans devoir réécrire l'historique.
  modeLivraison String          @default("domicile")
  statut        String          @default("en_attente")
  // État du contact client (call center COD). Optionnel car les commandes
  // existantes n'en ont pas → null par défaut. Voir EtatAppel dans lib/types.ts.
  etatAppel     String?
  // Notes libres de l'équipe (instructions livraison, historique d'échanges...).
  notes         String?
  createdAt     DateTime        @default(now())
  // Horodatages franchissement de chaque étape — remplis automatiquement
  // par mettreAJourCommandeAdmin quand le statut passe à la valeur cible.
  // Utilisés par la Timeline visible côté client (page confirmation + compte).
  confirmedAt   DateTime?
  enLivraisonAt DateTime?
  livreeAt      DateTime?
  annuleeAt     DateTime?

  utilisateurId String?
  utilisateur   Utilisateur?    @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  // Une commande appartient à UN marchand. C'est ce qui rend le panier
  // multi-marchands possible sans rien changer ici : un panier de trois
  // marchands produit trois Commande, chacune avec sa livraison, son statut
  // et son encaissement propres.
  boutiqueId    String
  boutique      Boutique        @relation(fields: [boutiqueId], references: [id])

  lignes        LigneCommande[]

  @@index([boutiqueId])
}

// ══════════════════════════════════════════════════════════════════════
// LigneCommande — SNAPSHOT d'un article au moment de la commande
// ══════════════════════════════════════════════════════════════════════
// Notes :
//  - nomProduit et prixUnitaire sont COPIÉS ici, pas juste référencés.
//    Voir explication du "snapshot" dans le message pédagogique.
//  - onDelete: Cascade sur commandeId : si une commande est supprimée,
//    ses lignes le sont aussi (elles n'ont pas de sens seules).
//  - onDelete: SetNull sur produitId : si un produit est supprimé, la
//    ligne existe toujours (elle a son propre snapshot du nom et du prix).
// ══════════════════════════════════════════════════════════════════════
// TarifLivraison — un tarif par wilaya
// ══════════════════════════════════════════════════════════════════════
// Une ligne par wilaya (code officiel "01" à "58").
//  - prixDomicile : livraison à l'adresse du client. NULL = ce groupe de
//    wilayas n'est PAS livré à domicile (retrait au bureau uniquement).
//  - prixStopdesk : retrait au bureau du transporteur (toujours moins cher)
//
// ⚠️ Règle : PRÉSENCE DE LA LIGNE = wilaya desservie.
// Une wilaya sans ligne n'est pas livrée — plus besoin d'un booléen `actif`.
// L'admin manipule des GROUPES (plusieurs wilayas au même tarif) ; les groupes
// sont déduits à la lecture en regroupant les wilayas de mêmes prix, ce qui
// évite une table de jointure et garde la recherche de tarif immédiate.
// Clé composite : chaque marchand a SA grille des 58 wilayas. Avec `wilaya`
// seule en clé primaire, le deuxième marchand n'aurait pas pu enregistrer un
// tarif pour Alger — la collision était garantie, pas seulement probable.
model TarifLivraison {
  wilaya       String
  prixDomicile Int?
  prixStopdesk Int

  boutiqueId   String
  boutique     Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@id([boutiqueId, wilaya])
}

// ══════════════════════════════════════════════════════════════════════
// ParametresBoutique — réglages globaux (ligne UNIQUE)
// ══════════════════════════════════════════════════════════════════════
// Table à une seule ligne, dont l'id est figé à "boutique".
// Le jour où la plateforme devient multi-boutique, cet id devient la clé
// de rattachement au marchand — la structure n'aura pas à changer.
// Une ligne par boutique — l'id EST le boutiqueId. Le commentaire d'origine
// anticipait ce jour : « le jour où la plateforme devient multi-boutique, cet
// id devient la clé de rattachement au marchand ». C'est fait.
model ParametresBoutique {
  boutiqueId             String   @id
  boutique               Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  /// Montant à partir duquel la livraison est offerte. null = jamais.
  /// ⚠️ Le seuil s'applique PAR MARCHAND. Sur un panier marketplace à trois
  /// marchands, trois seuils distincts sont évalués — le client peut donc
  /// n'en atteindre aucun alors que son total global les dépasse.
  seuilLivraisonGratuite Int?
}

model LigneCommande {
  id           String    @id @default(cuid())
  nomProduit   String
  prixUnitaire Int
  quantite     Int
  sousTotal    Int

  commandeId   String
  commande     Commande  @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  produitId    String?
  produit      Produit?  @relation(fields: [produitId], references: [id], onDelete: SetNull)
}

// ══════════════════════════════════════════════════════════════════════
// Categorie — catalogue des rayons de la boutique
// ══════════════════════════════════════════════════════════════════════
// Auparavant une union TypeScript figée : ajouter un rayon imposait un
// déploiement. Désormais une table, alimentée par l'admin depuis une liste
// prédéfinie (jamais de saisie libre, pour éviter les doublons et garantir
// une traduction correcte dans les deux langues).
//
// L'id est le slug ("mode", "beaute"), celui-là même stocké dans
// Produit.categorie — la relation reste donc implicite et sans jointure.
// Clé composite, pour la même raison que les tarifs : les rayons viennent
// d'un catalogue prédéfini de 38 slugs. Deux marchands voudront tous les deux
// « mode » — avec `id` seul en clé primaire, le second en aurait été privé.
model Categorie {
  id     String
  nomFr  String
  nomAr  String
  /// Ordre d affichage dans les filtres. Plus petit = plus haut.
  ordre  Int    @default(0)

  boutiqueId String
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@id([boutiqueId, id])
}
